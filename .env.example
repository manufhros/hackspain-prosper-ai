# Desk-issued team key. Never commit your real .env.
PLATFORM_API_KEY=
PLATFORM_API_BASE_URL=https://hackspain.getprosperapp.com

# Model used by the TUI (receptionist + automated caller) and `bun run serve`.
# local runs Qwen via llama.cpp; openrouter skips local Qwen. ASR_PROVIDER is independent.
LLM_PROVIDER=local
# Required only with LLM_PROVIDER=openrouter: a tools + structured-output model ID.
OPENROUTER_MODEL=
OPENROUTER_MAX_TOKENS=4096
# Prefer responsive providers. Use price to prioritize cost instead.
OPENROUTER_PROVIDER_SORT=latency
OPENROUTER_TIMEOUT_MS=20000
# auto uses low effort for Gemini 3; default leaves reasoning up to the provider.
OPENROUTER_REASONING_EFFORT=auto
# Takes precedence over the optional macOS Keychain entry in Setup.
OPENROUTER_API_KEY=

# Confirmation decisions use this separate OpenRouter Decisions model and the same key.
# Used even when the receptionist's conversation model is local. No phrase-matching fallback.
CONSENT_MODEL=typesafe/jev-1.13
CONSENT_TIMEOUT_MS=5000

# Optional, only for `bun run simulate:call`. Independent from the receptionist model.
# The simulator uses this key for caller chat and hosted listening, plus local Piper.
# Unset: reuse OPENROUTER_MODEL; fall back to openai/gpt-4.1-mini only if both are empty.
# Inherits OPENROUTER token/timeout/reasoning/provider-sort settings above.
# SIM_CALLER_MODEL=

# Transcription is independent of Qwen/chat. Set openrouter to send audio to hosted Whisper Turbo.
# Uses OPENROUTER_API_KEY above. OpenRouter manages routing (Groq is NOT guaranteed).
ASR_PROVIDER=local
# Bounded concurrent uploads; reduce if your OpenRouter account rate-limits requests.
OPENROUTER_ASR_CONCURRENCY=20
OPENROUTER_ASR_TIMEOUT_MS=12000

# Local capacity profile for M4 Pro / 48 GB; live 20-call latency is not established.
# llama (default) or ollama (one-slot baseline).
LOCAL_LLM_BACKEND=llama
LOCAL_LLM_PARALLEL=4
LOCAL_LLM_CONTEXT=16384
LOCAL_LLM_MAX_TOKENS=512
LOCAL_TTS_WORKERS=2
LOCAL_TTS_THREADS=2
# small (default) or large-v3-turbo (downloads a separate ~1.6 GB model).
LOCAL_ASR_MODEL=small
# transcribe (default); segment is an opt-in single-encoding experiment for short speech.
LOCAL_ASR_DECODER=transcribe

# Optional settings for `bun run serve`.
VOICE_HOST=127.0.0.1
VOICE_PORT=7860
VOICE_LANGUAGE=es
VOICE_MAX_CALLS=20
# A short spoken notice while waiting; a bounded total model/tool turn.
VOICE_WAIT_NOTICE_MS=4000
VOICE_TURN_TIMEOUT_MS=25000
VOICE_CALL_TIMEOUT_MS=180000
VOICE_VAD=silero
VOICE_VAD_PROBABILITY=0.5
# Used only with VOICE_VAD=energy (explicit diagnostic fallback).
VOICE_VAD_THRESHOLD=0.015
VOICE_SILENCE_MS=480
# Optional shared endpoint secret; configure the same Bearer header in Prosper.
# Keep the real value out of source control. It is not the PLATFORM_API_KEY.
VOICE_SERVER_TOKEN=

{
  "name": "hackspain-prosper-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "node --env-file=.env --import tsx src/agent/server.ts",
    "desk": "npm --prefix desk run dev",
    "desk:extract": "node desk/scripts/extract-logs.mjs",
    "agent:configure": "node --env-file=.env --import tsx src/scripts/configure-agent.ts",
    "clinic:fetch": "node --env-file=.env --import tsx src/scripts/fetch-clinic.ts",
    "clinic:smoke": "node --env-file=.env --import tsx src/scripts/smoke.ts",
    "test": "node --env-file=.env --import tsx --test src/agent/*.test.ts",
    "test:live": "node --env-file=.env --import tsx src/scripts/check.ts",
    "cf:types": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --env-interface Env worker-configuration.d.ts",
    "cf:typecheck": "npm run cf:types && tsc --project tsconfig.worker.json",
    "cf:check": "wrangler deploy --dry-run",
    "cf:deploy": "wrangler deploy",
    "cf:dev": "wrangler dev",
    "desk:cf:check": "npm --prefix desk run cf:check",
    "desk:cf:deploy": "npm --prefix desk run cf:deploy",
    "test:worker": "node --import tsx --test src/worker/*.test.mjs",
    "calls:import": "node --import tsx src/scripts/import-call-logs.mjs",
    "test:import": "node --import tsx --test src/scripts/import-call-logs.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "wrangler": "^4.135.0"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}

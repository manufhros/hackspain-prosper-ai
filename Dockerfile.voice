FROM python:3.11-slim
COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /uvx /bin/
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PYTHONUNBUFFERED=1
COPY pyproject.toml uv.lock ./
COPY src/clinic_voice ./src/clinic_voice
RUN uv sync --frozen --no-dev && useradd --create-home voice && mkdir -p /app/data/voice && chown -R voice:voice /app
USER voice
EXPOSE 7860
CMD ["uv", "run", "--no-sync", "uvicorn", "clinic_voice.app:app", "--host", "0.0.0.0", "--port", "7860", "--workers", "1"]

{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "prosper-voice",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-09-19",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "CALLS",
				"class_name": "VoiceCall"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"VoiceCall"
			]
		}
	],
	"d1_databases": [
		{
			"binding": "prosper_desk",
			"database_name": "prosper-desk",
			"database_id": "2d1a883d-639b-4246-a6cc-d6e0bc69c571",
			"migrations_dir": "desk/migrations"
		}
	],
	"vars": {
		"VOICE_STORAGE": "d1",
		"PLATFORM_API_BASE_URL": "https://hackspain.getprosperapp.com"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		}
	}
}
